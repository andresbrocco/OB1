    "database_info": {
      "type": "postgresql + pgvector",
      "primary_platform": "Supabase (cloud-managed)",
      "self_hosted_alternative": "ankane/pgvector:v0.5.1 via Kubernetes or Docker",
      "core_table": "thoughts (id BIGSERIAL, content TEXT, embedding vector(1536), metadata JSONB, created_at TIMESTAMPTZ)",
      "core_functions": ["match_thoughts (vector similarity search)", "upsert_thought (dedup by content hash)"],
      "migrations_path": "schemas/*/schema.sql and schemas/*/migration.sql",
      "extension_schemas": [
